# ============================================================
# Test Case Enhancement — Spec Compliance Verifier
# Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# CLI flags (--api-key, --model) always override these values.
# ============================================================

# --- LLM Provider & Model ---
# LiteLLM format: provider/model-name
# Examples:
#   openai/gpt-5-mini
#   openai/gpt-4o-mini
#   openai/gpt-4o
#   anthropic/claude-3-5-sonnet-20241022
#   openrouter/anthropic/claude-3.5-sonnet
LLM_MODEL=openai/gpt-5-mini

# --- API Keys ---
# Set the key for whichever provider you are using.
OPENAI_API_KEY=
# Uncomment if using Anthropic directly:
# ANTHROPIC_API_KEY=sk-ant-...

# Uncomment if using OpenRouter:
# OPENROUTER_API_KEY=sk-or-...

# --- Target Application ---
# Default URL — overridden by --url flag
TARGET_URL=http://localhost:8080

# --- Output ---
# Default output directory — overridden by --output flag
OUTPUT_DIR=output

# --- Debug ---
# Set to "true" to enable debug logging to file
DEBUG=true
